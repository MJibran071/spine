# --- environment / secrets ---------------------------------------------------
.env
.env.*
*.pem
*.key

# --- generated fleet state (reports/ is runtime output, not source) ----------
reports/
*.log
events.jsonl

# --- foundry build artifacts -------------------------------------------------
cache/
out/
broadcast/

# --- agent-generated harnesses (regenerated by the fleet every lab cycle) ----
test/agent/

# --- dependencies ------------------------------------------------------------
node_modules/
lib/

# --- OS / tooling junk (kept out of the public repo) -------------------------
.DS_Store

# --- Freebuff runtime metadata -----------------------------------------------
.freebuff/

# --- agent memory runtime state (venv + vector store; sidecar.py is source) --
agent/memory/venv/
agent/memory/storage/

# --- machine-local key/config files (launchd plists embed private fork URLs) --
agent/.llm-key*
agent/*.plist
